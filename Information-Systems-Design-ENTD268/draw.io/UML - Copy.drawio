<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.17 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36" version="24.7.17">
  <diagram name="Enhanced UML Class Diagram">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Patient Class -->
        <mxCell id="Patient" value="Patient" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="Patient_Attributes" value="patientID: int&#xa;firstName: string&#xa;lastName: string&#xa;email: string&#xa;assignedAppointments: Set&lt;Appointment&gt;" parent="Patient" vertex="1">
          <mxGeometry y="25" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Patient_Operations" value="+scheduleAppointment(): void&#xa;+cancelAppointment(): void" parent="Patient" vertex="1">
          <mxGeometry y="100" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Appointment Class -->
        <mxCell id="Appointment" value="Appointment" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="Appointment_Attributes" value="appointmentID: int&#xa;date: Date&#xa;status: string" parent="Appointment" vertex="1">
          <mxGeometry y="25" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Appointment_Operations" value="+confirmAppointment(): void" parent="Appointment" vertex="1">
          <mxGeometry y="100" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ClinicalStaff Class -->
        <mxCell id="ClinicalStaff" value="ClinicalStaff" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="550" y="50" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ClinicalStaff_Attributes" value="staffID: int&#xa;name: string&#xa;specialization: string" parent="ClinicalStaff" vertex="1">
          <mxGeometry y="25" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Composition: Patient to Appointment -->
        <mxCell id="composition1" style="edgeStyle=orthogonalEdgeStyle;endArrow=diamond;endFill=1;" edge="1" parent="1" source="Patient" target="Appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Receptionist Class -->
        <mxCell id="Receptionist" value="&lt;&lt;actor&gt;&gt; Receptionist" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="Receptionist_Attributes" value="receptionistID: int&#xa;name: string" parent="Receptionist" vertex="1">
          <mxGeometry y="25" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Relationship with Multiplicities -->
        <mxCell id="relation1" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;" edge="1" parent="1" source="Receptionist" target="Appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Administrator Class -->
        <mxCell id="Administrator" value="&lt;&lt;actor&gt;&gt; Administrator" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="200" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
